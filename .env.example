# Token inicial (semeado no banco no primeiro boot; depois rotacione via API).
ISY_TOKEN=544c5787-613a-4ac2-8e61-9e6486f8d74a

# Banco. SQLite por padrao; para Postgres:
# ISY_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/isyone
ISY_DATABASE_URL=sqlite:///./isyone.db

# Diretorio dos shell scripts (montado por volume no container).
ISY_SCRIPTS_DIR=./scripts

# Timeout por execucao (segundos).
ISY_EXEC_TIMEOUT=30

# Webhook opcional para alertas em falha (Discord/Telegram-compativel).
ISY_ALERT_WEBHOOK_URL=

# Semeia scripts de demonstracao no primeiro boot (banco vazio).
ISY_SEED_DEMO=false

# Origens liberadas no CORS, separadas por virgula (Swagger do GitHub Pages).
ISY_CORS_ORIGINS=https://lumiguelx.github.io
